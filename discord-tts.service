[Unit]
Description=DaLines Discord & Twitch TTS Bot Service
After=network.target

[Service]
Type=simple
User=danaiwongvichian
WorkingDirectory=/home/danaiwongvichian/discord-tts
ExecStart=/home/danaiwongvichian/discord-tts/.venv/bin/python bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
