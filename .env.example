# ใส่ Discord Bot Token ที่ได้จาก Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# เสียงเริ่มต้น (th-TH-PremwadeeNeural = ผู้หญิง, th-TH-NiwatNeural = ผู้ชาย)
DEFAULT_VOICE=th-TH-PremwadeeNeural

# ความเร็วเริ่มต้น (+0%, +15%, +30%)
DEFAULT_RATE=+0%

# ความยาวข้อความสูงสุดที่จะอ่าน (ตัวอักษร)
MAX_TEXT_LENGTH=250

# ออกจากห้องเสียงอัตโนมัติเมื่อไม่มีคนอยู่ (วินาที)
AUTO_DISCONNECT_SECONDS=60
